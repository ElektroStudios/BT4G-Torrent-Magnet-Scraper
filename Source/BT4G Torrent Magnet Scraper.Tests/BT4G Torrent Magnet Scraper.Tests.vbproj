<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BT4G Torrent Magnet Scraper.Tests</AssemblyName>
    <RootNamespace></RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>Off</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <!-- Same versions as the main project (packages.config). -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Selenium.WebDriver" Version="4.52.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The main project only defines x64 configurations. -->
    <ProjectReference Include="..\BT4G Torrent Magnet Scraper\BT4G Torrent Magnet Scraper.vbproj">
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration files shipped with the application, used to verify they remain parseable. -->
    <None Include="..\BT4G Torrent Magnet Scraper\config\*.txt" Link="TestData\config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
